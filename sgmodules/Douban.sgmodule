#!name=豆瓣
#!desc=过滤豆瓣广告，仅去除开屏广告。作者：ishowshu、fmz200。由 Loon 插件转换：3 条开屏广告接口/素材拦截，返回 200 空 JSON。
#!category=去广告

[Script]
Douban-1 = type=http-request, pattern=(?i)^https://storage\.360buyimg\.com/material-video/video/[a-f0-9]{32}\.mp4$, script-path=https://raw.githubusercontent.com/blackfiry/anywhere-rules/main/sgmodules/douban.js
Douban-2 = type=http-request, pattern=(?i)^https://img\d+\.360buyimg\.com/pop/jfs/t\d+/\d+/\d+/\d+/\d+/[A-Za-z0-9]{10,40}/[A-Za-z0-9]{10,40}\.jpg$, script-path=https://raw.githubusercontent.com/blackfiry/anywhere-rules/main/sgmodules/douban.js
Douban-3 = type=http-request, pattern=(?i)^https://api\.douban\.com/v2/app_ads, script-path=https://raw.githubusercontent.com/blackfiry/anywhere-rules/main/sgmodules/douban.js

[MITM]
hostname = %APPEND% *.360buyimg.com, api.douban.com
