#!name=RevenueCat解锁
#!desc=RevenueCat系列解锁合集（Anywhere 模块）

[Rule]

[URL Rewrite]

[Script]
Reheji_response = type=http-response,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js
Reheji_header = type=http-request,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com
